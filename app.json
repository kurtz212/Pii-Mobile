{
  "expo": {
    "name": "Pii",
    "slug": "pii-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1F3A5F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pii.app"
    },
    "android": {
      "package": "com.pii.app"
    },
    "plugins": [
      "expo-status-bar",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Pii à accéder à votre position pour la partager dans une conversation."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Autoriser Pii à accéder à vos contacts pour partager un contact dans une conversation."
        }
      ]
    ]
  }
}
