{
  "expo": {
    "name": "Pii",
    "slug": "pii-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/pi.jpeg",
    "splash": {
      "backgroundColor": "#1F3A5F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pii.app"
    },
    "android": {
      "package": "com.pii.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
       "plugins": [
      "expo-status-bar",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Pii à accéder à votre position pour la partager dans une conversation."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Autoriser Pii à accéder à vos contacts pour partager un contact dans une conversation."
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "3e2c9e99-1f0f-4282-99e6-490c9bd5eb90"
      }
    }
  }
}
